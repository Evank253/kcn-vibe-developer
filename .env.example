# ==============================================================================
# KCN Vibe Developer / Coder — environment configuration
# Copy this file to .env and fill in the blanks. NEVER commit the real .env.
# ==============================================================================

# --- Chain / RPC -------------------------------------------------------------
# Base Sepolia (testnet) — use this first, deploy + test the whole flow with
# fake ETH before touching Base mainnet.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Base mainnet — only set this up once the testnet flow is fully verified.
BASE_RPC_URL=https://mainnet.base.org
# Which RPC the running server actually talks to at runtime.
RPC_URL=https://sepolia.base.org

# Optional: Basescan API key, only needed if you want `hardhat verify` to
# publish source on Basescan after deploying.
BASESCAN_API_KEY=

# --- Deployer / minter wallet --------------------------------------------------
# This wallet deploys the contracts AND is the one the server uses to call
# mintWithReverse() / mintAgent() on every claim. It needs MINTER_ROLE on both
# contracts (the deploy script grants this automatically to the deployer).
#
# NEVER commit a real private key. Generate a wallet dedicated to this
# purpose only — do not reuse a wallet that holds other funds.
DEPLOYER_PRIVATE_KEY=
MINTER_PRIVATE_KEY=

# --- Contract addresses (filled in after you run the deploy script) -----------
TOKEN_CONTRACT_ADDRESS=
NFT_CONTRACT_ADDRESS=

# --- Creator wallet (reverse-mint destination) ---------------------------------
# Every first-purchase mint sends a token share here automatically. This is
# a real address Evan generated via the MetaMask browser extension — safe to
# be public since it's just an address, not a key.
CREATOR_WALLET_ADDRESS=0xc35C2E6B755C0Bdf5De04fFD80Ee871e36b9062c

# --- Tokenomics (placeholders — see docs/ECONOMY.md, NOT locked yet) ----------
TOKENS_PER_USD=100
CREATOR_REVERSE_MINT_PCT=0.10

# --- Stripe --------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Server ----------------------------------------------------------------
PORT=4100
